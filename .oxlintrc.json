{
  // Oxlint's configuration for this repository.
  //
  // Every rule is named. Under ESLint the bulk of them arrived through
  // `eslint:recommended`, `strictTypeChecked`, `unicorn/recommended` and the
  // rest, and a preset gaining a rule brought it here on the next upgrade.
  // Oxlint has no equivalent of extending a plugin's own preset, so the set is
  // written out instead. The trade is deliberate: what this repository
  // enforces is now readable in one file, and a preset growing a rule is
  // something to pick up on purpose rather than something that lands silently.
  //
  // Four ESLint plugins are loaded through Oxlint's JS plugin API rather than
  // reimplemented, alongside two written for Oxlint directly: this
  // repository's own restrictions, and the assertion advice `@kensio/smartass`
  // publishes. Oxlint carries native `unicorn` and `jsdoc` plugins whose
  // rule coverage is a long way short of what this repository uses — 166 and 18
  // of ours have no native counterpart — so both are taken wholesale from the
  // real plugin under an alias. `unicorn` and `jsdoc` are reserved names, which
  // is why the aliases exist.
  //
  // Nothing in `--type-aware` reaches a JS plugin: Oxlint runs those without
  // type information, and less scope information than ESLint gives them. Two
  // rules are gone outright because of it, and six Unicorn rules are off for
  // the same reason — see the block among the Unicorn rules below.
  //
  //   `@typescript-eslint/naming-convention` calls `getParserServices()`
  //   unconditionally, so it cannot run here at all. Oxlint has no `camelcase`
  //   either. Identifier casing is no longer a lint gate; it is a review
  //   matter, and the 29 disable directives that used to suppress AWS-shaped
  //   names went with it.
  //
  //   `no-octal` has no Oxlint rule, and needs none: modules are strict mode,
  //   where a legacy octal literal is a parse error rather than a lint finding.
  //
  // `no-restricted-syntax` is also absent, but it did survive: this
  // repository's selectors moved into the `yulin` plugin below as named rules,
  // and the 47 that used to arrive from `@kensio/smartass` as a
  // `no-restricted-syntax` block now come from the Oxlint plugin it publishes.
  //
  // The published `cff-js2` plugin is not loaded here. It restricts syntax to
  // what the CloudFront Functions JS2 runtime will run, this repository has no
  // `.cff.js` files of its own, and `src/config/oxlint/` already tests it
  // against Oxlint. Consumers get it through `@kensio/yulin/oxlint`.
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "ignorePatterns": [
    "tmp/",
    ".tmp/",
    "dist/",
    "coverage/",
    "test/.coverage/",
    "node_modules/",
    "**/*.config.ts",
    ".claude/"
  ],

  // Only the native plugins whose rules are named below. Oxlint's `unicorn`
  // and `jsdoc` are deliberately absent; the JS plugins below stand in for
  // them.
  "plugins": ["typescript", "oxc", "vitest"],

  // Oxlint turns its `correctness` category on by default, which would add
  // rules on top of the set below without them appearing anywhere. The list is
  // the gate, so the category is off.
  "categories": { "correctness": "off" },

  "jsPlugins": [
    { "name": "unicorn-js", "specifier": "eslint-plugin-unicorn" },
    { "name": "jsdoc-js", "specifier": "eslint-plugin-jsdoc" },
    { "name": "security", "specifier": "eslint-plugin-security" },
    { "name": "no-secrets", "specifier": "eslint-plugin-no-secrets" },
    { "name": "smartass", "specifier": "@kensio/smartass/oxlint" },
    { "name": "yulin", "specifier": "./src/config/lint/repo-lint-plugin.ts" }
  ],

  "rules": {
