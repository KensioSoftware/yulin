{
  "name": "@kensio/yulin",
  "version": "0.1.2",
  "description": "AWS system behaviour simulation for isolated unit testing",
  "repository": "https://github.com/KensioSoftware/yulin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "fmt": "eslint --fix '{src,test}/**/*.{ts,js}' && prettier --write '{src,test}/**/*.{ts,js,json,md,css,html,yml,yaml}'",
    "lint": "eslint '{src,test}/**/*.{ts,js}' && prettier --check '{src,test}/**/*.{ts,js,json,md,css,html,yml,yaml}'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "aws",
    "test",
    "mock",
    "emulator",
    "simulator",
    "isolated"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cloudfront": {
      "types": "./dist/service/cloudfront/index.d.ts",
      "import": "./dist/service/cloudfront/index.js"
    },
    "./cloudfront/globals": {
      "types": "./dist/service/cloudfront/globals.d.ts",
      "import": "./dist/service/cloudfront/globals.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Kensio Software",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@11.4.0",
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1057.0",
    "@aws-sdk/client-s3": "^3.1057.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@kensio/smartass": "^1.0.2",
    "@smithy/smithy-client": "^4.13.5",
    "@smithy/types": "^4.14.2",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/eslint-plugin": "^1.6.18",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1001.0",
    "@aws-sdk/client-s3": "^3.1001.0",
    "@faker-js/faker": "^10.4.0",
    "@smithy/smithy-client": "^4.12.1"
  },
  "peerDependenciesMeta": {
    "@smithy/smithy-client": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/client-dynamodb": {
      "optional": true
    }
  },
  "dependencies": {
    "@kensio/part-factory": "^0.1.1",
    "lodash-es": "^4.18.1"
  }
}
