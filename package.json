{
  "name": "@kensio/yulin",
  "version": "0.32.0",
  "description": "AWS system behaviour simulation for isolated unit testing",
  "repository": "https://github.com/KensioSoftware/yulin",
  "homepage": "https://yulinsim.dev/",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "fmt": "eslint --fix . && prettier --write .",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:coverage": "rm -rf './.tmp/' && vitest run --coverage",
    "test:iso": "vitest run --project isolatedTests",
    "test:local": "rm -rf './.tmp/' && vitest run --project localTests",
    "examples:extract": "pnpm tsx scripts/mts/extract-docs-examples.mts",
    "examples:tsc": "tsc -p docs/tsconfig.json",
    "examples:lint": "eslint \"docs/**/*.example.ts\"",
    "examples:check": "pnpm examples:extract && pnpm examples:tsc && pnpm examples:lint",
    "fta": "./scripts/sh/fta.sh",
    "check": "pnpm fmt && pnpm fta && pnpm build:check && pnpm examples:check && pnpm test:coverage"
  },
  "keywords": [
    "aws",
    "test",
    "mock",
    "emulator",
    "simulator",
    "isolated"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cloudformation": {
      "import": "./dist/service/cloudformation/index.js",
      "types": "./dist/service/cloudformation/index.d.ts"
    },
    "./cloudfront": {
      "import": "./dist/service/cloudfront/index.js",
      "types": "./dist/service/cloudfront/index.d.ts"
    },
    "./cloudfront/globals": {
      "import": "./dist/service/cloudfront/globals.js",
      "types": "./dist/service/cloudfront/globals.d.ts"
    },
    "./dynamodb": {
      "import": "./dist/service/dynamodb/index.js",
      "types": "./dist/service/dynamodb/index.d.ts"
    },
    "./eslint": {
      "import": "./dist/config/eslint/index.js",
      "types": "./dist/config/eslint/index.d.ts"
    },
    "./iam": {
      "import": "./dist/service/iam/index.js",
      "types": "./dist/service/iam/index.d.ts"
    },
    "./package.json": "./package.json",
    "./s3": {
      "import": "./dist/service/s3/index.js",
      "types": "./dist/service/s3/index.d.ts"
    },
    "./route53": {
      "import": "./dist/service/route53/index.js",
      "types": "./dist/service/route53/index.d.ts"
    },
    "./serve": {
      "import": "./dist/serve/index.js",
      "types": "./dist/serve/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Kensio Software",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.13.0",
  "devDependencies": {
    "@aws-sdk/client-acm": "^3.1086.0",
    "@aws-sdk/client-cloudformation": "^3.1086.0",
    "@aws-sdk/client-cloudfront": "^3.1086.0",
    "@aws-sdk/client-dynamodb": "^3.1086.0",
    "@aws-sdk/client-iam": "^3.1086.0",
    "@aws-sdk/client-route-53": "^3.1086.0",
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/client-sts": "^3.1086.0",
    "@eslint/js": "^10.0.1",
    "@kensio/smartass": "^1.34.0",
    "@smithy/smithy-client": "^4.14.8",
    "@smithy/types": "^4.16.1",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "aws-cdk": "^2.1130.0",
    "aws-cdk-lib": "^2.261.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.6.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "^66.0.0",
    "execa": "^9.6.1",
    "fta-cli": "^3.0.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@kensio/part-factory": "^1.6.0",
    "lodash-es": "^4.18.1"
  },
  "peerDependencies": {
    "eslint": "^10.4.1",
    "typescript-eslint": "^8.60.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  }
}
